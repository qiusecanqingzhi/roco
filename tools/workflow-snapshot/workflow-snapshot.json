[
 {
  "file": ".github/workflows/sync.yml",
  "doc": {
   "name": "同步图鉴数据",
   "on": {
    "schedule": [
     {
      "cron": "17 4 * * 1,4"
     }
    ],
    "workflow_dispatch": {
     "inputs": {
      "force": {
       "description": "忽略版本比对，强制重抓并重新发布",
       "type": "boolean",
       "default": false
      },
      "locale": {
       "description": "要同步的语言",
       "type": "choice",
       "options": [
        "zh-Hans",
        "en-US",
        "vi-VN",
        "pt-BR",
        "ja-JP"
       ],
       "default": "zh-Hans"
      }
     }
    },
    "push": {
     "branches": [
      "main"
     ],
     "paths": [
      "web/index.html",
      "web/app.js",
      "web/style.css",
      ".github/workflows/sync.yml"
     ]
    }
   },
   "permissions": {
    "contents": "write",
    "pages": "write",
    "id-token": "write"
   },
   "concurrency": {
    "group": "sync-and-deploy",
    "cancel-in-progress": false
   },
   "jobs": {
    "sync": {
     "runs-on": "ubuntu-latest",
     "timeout-minutes": 40,
     "outputs": {
      "publish": "${{ steps.plan.outputs.publish }}",
      "changed": "${{ steps.sync.outputs.changed }}",
      "version": "${{ steps.sync.outputs.local_version }}"
     },
     "steps": [
      {
       "uses": "actions/checkout@v4"
      },
      {
       "uses": "actions/setup-node@v4",
       "with": {
        "node-version": "22"
       }
      },
      {
       "name": "检查上游版本",
       "id": "check",
       "continue-on-error": true,
       "env": {
        "LOCALE": "${{ inputs.locale || 'zh-Hans' }}"
       },
       "run": "node tools/sync.mjs --check --locale \"$LOCALE\""
      },
      {
       "name": "决定是否同步",
       "id": "plan",
       "env": {
        "FORCE": "${{ inputs.force }}",
        "CHANGED": "${{ steps.check.outputs.changed }}",
        "EVENT": "${{ github.event_name }}"
       },
       "run": "if [ \"$FORCE\" = \"true\" ] || [ \"$CHANGED\" = \"true\" ] || [ \"$EVENT\" != \"schedule\" ]; then\n  echo \"publish=true\" >> \"$GITHUB_OUTPUT\"\n  echo \"→ 将执行同步并重新发布\"\nelse\n  echo \"publish=false\" >> \"$GITHUB_OUTPUT\"\n  echo \"→ 上游无更新，本次跳过（省额度）\"\nfi\n"
      },
      {
       "name": "同步（抓取 → 导出 → 补图 → 打包）",
       "id": "sync",
       "if": "steps.plan.outputs.publish == 'true'",
       "env": {
        "LOCALE": "${{ inputs.locale || 'zh-Hans' }}",
        "ROCO_DEPLOY": "gh-pages"
       },
       "run": "node tools/sync.mjs --locale \"$LOCALE\""
      },
      {
       "name": "自检",
       "if": "steps.plan.outputs.publish == 'true'",
       "run": "node tools/chk-markup.mjs\nnode web/tools/test-app.mjs\nif [ \"${{ vars.RUN_PAGE_TESTS }}\" = \"true\" ]; then\n  node web/tools/test-app2.mjs\nfi\n"
      },
      {
       "name": "检查数据是否有实际变化",
       "id": "diff",
       "if": "steps.plan.outputs.publish == 'true'",
       "run": "if [ \"${{ steps.sync.outputs.changed }}\" = \"true\" ] || ! git diff --quiet -- web/data web/assets web/data-bundle.js; then\n  echo \"changed=true\" >> \"$GITHUB_OUTPUT\"\n  echo \"→ 数据有变化，将提交\"\nelse\n  echo \"changed=false\" >> \"$GITHUB_OUTPUT\"\n  echo \"→ 数据无实际变化\"\nfi\n"
      },
      {
       "name": "提交数据变更",
       "if": "steps.diff.outputs.changed == 'true'",
       "run": "git config user.name  'github-actions[bot]'\ngit config user.email '41898282+github-actions[bot]@users.noreply.github.com'\ngit add web/data web/assets web/data-bundle.js\ngit commit -m \"chore(data): 同步上游 ${{ steps.sync.outputs.local_version }}（精灵 ${{ steps.sync.outputs.spirits }} / 技能 ${{ steps.sync.outputs.skills }}）\"\ngit push\n"
      },
      {
       "name": "上传 Pages 产物",
       "if": "steps.plan.outputs.publish == 'true'",
       "uses": "actions/upload-pages-artifact@v3",
       "with": {
        "path": "dist-share"
       }
      }
     ]
    },
    "deploy": {
     "needs": "sync",
     "if": "needs.sync.outputs.publish == 'true'",
     "runs-on": "ubuntu-latest",
     "environment": {
      "name": "github-pages",
      "url": "${{ steps.deploy.outputs.page_url }}"
     },
     "steps": [
      {
       "id": "deploy",
       "uses": "actions/deploy-pages@v4"
      }
     ]
    }
   }
  }
 }
]